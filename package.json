{
  "name": "beats-lms-v2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @lms/server dev",
    "web": "pnpm --filter @lms/web dev",
    "dev:both": "concurrently \"pnpm dev\" \"pnpm web\"",
    "ci:verify": "pnpm --filter @lms/server test:all-core && pnpm --filter @lms/server build && pnpm --filter @lms/web build",
    "smoke:prod": "bash scripts/prod-smoke.sh",
    "db:generate": "pnpm --filter @db generate",
    "db:migrate": "pnpm --filter @db migrate:dev",
    "db:seed": "pnpm --filter @db seed",
    "db:seed:beats20": "pnpm --filter @db run seed:beats20",
    "db:seed:licenses": "pnpm --filter @db run seed:licenses",
    "db:repair:license-seats": "pnpm --filter @db run repair:license-seats",
    "types:build": "pnpm --filter @lms/types build",
    "demo:reset": "ts-node --esm --transpile-only scripts/demo-reset.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "dependencies": {
    "axios": "^1.13.2"
  }
}
